# App
PORT=3000
APP_ENV=local
APP_URL=http://localhost:3000
CORS_URLS=http://localhost:5173
# Dominio de la cookie httpOnly del refresh token. Opcional: déjalo vacío (cookie host-only,
# atada al host de la API). Solo configúralo si necesitas compartirla entre subdominios que
# la leen, p.ej. .midominio.com
COOKIE_DOMAIN=
PUBLIC_API_KEY=change_me_use_a_long_random_secret

# Base de datos (única)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# JWT Admin
JWT_ADMIN_ACCESS_SECRET=change_me_access
JWT_ADMIN_REFRESH_SECRET=change_me_refresh

# JWT Expiry (optional — defaults: 15m / 7d)
JWT_ADMIN_ACCESS_EXPIRES=15m
JWT_ADMIN_REFRESH_EXPIRES=7d

# Sentry (optional — leave empty to disable)
SENTRY_DSN=

# OpenTelemetry → Grafana Cloud (optional — leave empty to disable)
# NODE_OPTIONS must be set in the process env BEFORE node starts (systemd/pm2/docker), not loaded from .env
# NODE_OPTIONS=--require @opentelemetry/auto-instrumentations-node/register
OTEL_SERVICE_NAME=motogp-api-performance
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-3.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64(instanceId:token)>"
OTEL_TRACES_EXPORTER=otlp
OTEL_NODE_RESOURCE_DETECTORS=env,host,os

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=localMasterKey
MEILI_INDEX=helmets

# Formulario de contacto (opcionales; por defecto el sandbox de Resend)
RESEND_FROM="Contact Form <onboarding@resend.dev>"
CONTACT_TO=tu-email@ejemplo.com
